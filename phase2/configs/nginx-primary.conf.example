# Mac 2 (10.7.1.194) - primary edge. Live path: /opt/homebrew/etc/nginx/nginx.conf
# Cert/key paths are machine-specific; the key itself is never committed.
worker_processes 1;

events { worker_connections 1024; }

http {
    upstream cn_backends {
        # passive failover (Extension D): 1 failure takes a server out for 5 s
        server 10.7.26.181:3001 max_fails=1 fail_timeout=5s;   # Backend A (Mac 3)
        server 10.7.27.143:3002 max_fails=1 fail_timeout=5s;   # Backend B (Mac 1)
    }

    server {
        listen 8443 ssl;
        server_name app.team1.test api.team1.test;

        ssl_certificate     /Users/harshilvalecha/cn-tls/app.team1.test.pem;
        ssl_certificate_key /Users/harshilvalecha/cn-tls/app.team1.test-key.pem;

        location / {
            proxy_pass http://cn_backends;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 2;
        }
    }
}
